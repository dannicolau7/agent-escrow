# Copy to .env and fill in.  Never commit .env.

# --- Required in production ---------------------------------------------------
# Generate keys with:  python -c "import secrets; print('sk_' + secrets.token_hex(24))"
# Format: label:role:key|label:role:key   (roles: agent, viewer, approver, admin)
ESCROW_KEYS=my-agent:agent:sk_CHANGE_ME_1|alice:approver:sk_CHANGE_ME_2|ops-admin:admin:sk_CHANGE_ME_3|prometheus:viewer:sk_CHANGE_ME_4

# The real MCP server approved calls are sent to (Streamable HTTP endpoint)
MCP_UPSTREAM_URL=https://mcp.example.com/mcp
# Credential for that server (sent as Authorization: Bearer ...). Optional.
MCP_UPSTREAM_TOKEN=

GRAFANA_PASSWORD=CHANGE_ME

# --- Optional -------------------------------------------------------------------
# Secret used to sign the audit log hash chain (strongly recommended)
ESCROW_AUDIT_KEY=
# Seconds an action waits for review before it is auto-rejected
ESCROW_HOLD_TIMEOUT=300
# wait = keep the agent's request open (SSE progress heartbeats); async = answer at
# once and let the agent poll the escrow_get_result tool. Use async if your MCP
# client times out before reviewers respond.
ESCROW_HOLD_MODE=wait
ESCROW_HEARTBEAT_SECONDS=15
# Comma-separated browser origins allowed to call the API (blank = same origin only)
ESCROW_CORS_ORIGINS=
# Interface the proxy port is published on. 127.0.0.1 = this machine only.
ESCROW_BIND=127.0.0.1
# Public hostname for the optional Caddy TLS profile
ESCROW_DOMAIN=

DASHBOARD_URL=https://escrow.example.com/ui/
SLACK_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
